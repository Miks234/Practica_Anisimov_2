<Window x:Class="Vhod.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Vhod"
        mc:Ignorable="d"
        Title="Вход" Height="450" Width="800" FontFamily="Comic Sans MS" MinHeight="350" MinWidth="400">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border x:Name="LoginBorder" BorderThickness="2" BorderBrush="#FF498B51" Padding="10" CornerRadius="15">
                <StackPanel MinWidth="300">
                    <TextBlock Text="Вход" HorizontalAlignment="Center" FontSize="24"/>
                    <TextBlock Text="Логин" Margin="0 10 0 0"/>
                    <TextBox x:Name="LoginBox"/>
                    <TextBlock Text="Пароль" Margin="0 10 0 0"/>
                    <PasswordBox x:Name="PassBox"/>
                    <Button x:Name="VhodButton" Content="Войти" Margin="0 20 0 0" Height="30" Background="#FF498B51" Foreground="White" Click="Vhod_Click"/>
                    <Button Content="Регистрация" Margin="0 20 0 0" Height="30" Background="#FF498B51" Foreground="White" Click="Reg_Click"/>
                </StackPanel>
            </Border>
            
            <Border x:Name="CaptchaBorder" BorderThickness="2" BorderBrush="Red" Padding="10" CornerRadius="15" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Соберите пазл" FontSize="18" HorizontalAlignment="Center" Margin="0 0 0 10"/>
                    <UniformGrid x:Name="PuzzleGrid" Rows="2" Columns="2" Width="300" Height="300" HorizontalAlignment="Center">
                        <Border Tag="0" MouseLeftButtonDown="PuzzlePiece_Click" BorderBrush="Black" BorderThickness="1">
                            <Image x:Name="P0" Stretch="Fill"/>
                        </Border>
                        <Border Tag="1" MouseLeftButtonDown="PuzzlePiece_Click" BorderBrush="Black" BorderThickness="1">
                            <Image x:Name="P1" Stretch="Fill"/>
                        </Border>
                        <Border Tag="2" MouseLeftButtonDown="PuzzlePiece_Click" BorderBrush="Black" BorderThickness="1">
                            <Image x:Name="P2" Stretch="Fill"/>
                        </Border>
                        <Border Tag="3" MouseLeftButtonDown="PuzzlePiece_Click" BorderBrush="Black" BorderThickness="1">
                            <Image x:Name="P3" Stretch="Fill"/>
                        </Border>
                    </UniformGrid>
                    <Button Content="Проверить пазл" Margin="0 10 0 0" Height="30" Click="CheckPuzzle_Click"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </Grid>
</Window>
