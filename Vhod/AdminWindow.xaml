<Window x:Class="Vhod.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Vhod"
        Title="Админпанель" Height="450" Width="800" 
        FontFamily="Comic Sans MS" MinHeight="350" MinWidth="400">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Пользователи" 
                   FontSize="20" FontWeight="Bold" Margin="0 0 0 10"/>

        <Button Content="Назад" Height="30" Width="70" 
                HorizontalAlignment="Right" Margin="20 0" 
                Background="#FF498B51" Foreground="White" 
                BorderBrush="#FF707070" Click="Button_Click"/>

        <ScrollViewer Grid.Row="1">
            <ItemsControl x:Name="UsersItemControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="Black" BorderThickness="1" 
                                Padding="10" Margin="0 0 0 5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock FontWeight="Bold">
                                        <Run Text="{Binding User_Surname, Mode=OneWay}"/>
                                        <Run Text="{Binding User_Name, Mode=OneWay}"/>
                                        <Run Text="{Binding User_Patronymic, Mode=OneWay}"/>
                                    </TextBlock>

                                    <TextBlock>
                                        <Run Text="Логин: "/>
                                        <Run Text="{Binding User_Login, Mode=OneWay}"/>
                                    </TextBlock>

                                    <TextBlock>
                                        <Run Text="Статус: "/>
                                    </TextBlock>

                                    <!-- Отдельный TextBlock для статуса -->
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Разблокирован"/>
                                                <Setter Property="Foreground" Value="Green"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding User_Status}" Value="True">
                                                        <Setter Property="Text" Value="Заблокирован"/>
                                                        <Setter Property="Foreground" Value="Red"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>

                                <Button Grid.Column="1" 
                                        Content="Заблокировать / Разблокировать" 
                                        Width="220" Height="30" 
                                        VerticalAlignment="Center" 
                                        Click="ToggleUserStatus_Click" 
                                        Tag="{Binding User_ID}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>